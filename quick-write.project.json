{
  "name": "writer-quick-write-pre-extraction",
  "purpose": "Machine-readable pre-extraction gate for the in-repo QuickWrite surface. This does not move files, change QuickWrite UI behavior, or create a standalone repository.",
  "extractionMode": "pre-extraction-manifest",
  "requiredPaths": [
    "quick-write.html",
    "src/apps/quick-write/main.tsx",
    "src/apps/quick-write/QuickWriteApp.tsx",
    "src/apps/quick-write/QuickWriteAppShell.tsx",
    "src/apps/quick-write/QuickWriteApp.css",
    "src/apps/quick-write/QuickWriteEditor.tsx",
    "src/apps/quick-write/QuickWriteMenuAdapter.tsx",
    "src/apps/quick-write/QuickWriteStatusBar.tsx",
    "src/apps/quick-write/quickWriteCommands.ts",
    "src/apps/quick-write/quickWriteNativeMenu.ts",
    "src/apps/quick-write/quickWriteRuntime.ts",
    "src/apps/quick-write/quickWriteTemplates.ts",
    "src/apps/quick-write/importBoundary.test.ts",
    "src/apps/quick-write/QuickWriteArchitecture.test.ts",
    "src-tauri/tauri.quick-write.conf.json",
    "src-tauri/QuickWriteTauriConfigBehavior.test.ts",
    "src-tauri/src/QuickWriteNativeMenuBehavior.test.ts",
    "src-tauri/src/QuickWriteWindowCommandBehavior.test.ts",
    "tsconfig.quick-write.json",
    "vite.quick-write.config.ts"
  ],
  "quickWriteObjects": {
    "entryHtml": [
      "quick-write.html",
      "src/apps/quick-write/main.tsx"
    ],
    "appShell": [
      "src/apps/quick-write/QuickWriteApp.tsx",
      "src/apps/quick-write/QuickWriteAppShell.tsx",
      "src/apps/quick-write/QuickWriteApp.css"
    ],
    "runtime": [
      "src/apps/quick-write/quickWriteRuntime.ts",
      "src/apps/quick-write/quickWriteTemplates.ts",
      "src/core/session/index.ts",
      "src/core/autosave/index.ts",
      "src/core/runtime/index.ts",
      "src/services/runtime/TauriRuntimePorts.ts"
    ],
    "menu": [
      "src/apps/quick-write/QuickWriteMenuAdapter.tsx",
      "src/apps/quick-write/quickWriteCommands.ts",
      "src/apps/quick-write/quickWriteNativeMenu.ts",
      "src/core/command/index.ts",
      "src/ui/chrome/SchemaMenuBar.tsx",
      "src/ui/chrome/menuSchema.ts"
    ],
    "status": [
      "src/apps/quick-write/QuickWriteStatusBar.tsx",
      "src/ui/statusbar/StatusBarView.tsx",
      "src/ui/statusbar/statusBarUtils.ts",
      "src/state/slices/statusSlice.ts"
    ],
    "editor": [
      "src/apps/quick-write/QuickWriteEditor.tsx",
      "src/domains/editor/core/SingleDocumentEditor.tsx",
      "src/core/editor/index.ts"
    ],
    "tauriConfigAndNativeTests": [
      "src-tauri/tauri.quick-write.conf.json",
      "src-tauri/QuickWriteTauriConfigBehavior.test.ts",
      "src-tauri/src/QuickWriteNativeMenuBehavior.test.ts",
      "src-tauri/src/QuickWriteWindowCommandBehavior.test.ts"
    ]
  },
  "uiFidelityBaseline": {
    "classificationValues": [
      "core",
      "quickwrite-copy",
      "adapter",
      "writer-retain",
      "later-decision"
    ],
    "classificationMatrix": {
      "QuickWriteAppShell": {
        "classification": "quickwrite-copy",
        "paths": [
          "src/apps/quick-write/QuickWriteAppShell.tsx",
          "src/apps/quick-write/QuickWriteApp.css"
        ],
        "baseline": "QuickWrite-owned shell and CSS keep the in-repo visual surface without copying the Writer app shell."
      },
      "QuickWriteEditor": {
        "classification": "adapter",
        "paths": [
          "src/apps/quick-write/QuickWriteEditor.tsx"
        ],
        "baseline": "QuickWrite adapts commands and lifecycle to the retained shared SingleDocumentEditor."
      },
      "QuickWriteMenuAdapter": {
        "classification": "adapter",
        "paths": [
          "src/apps/quick-write/QuickWriteMenuAdapter.tsx"
        ],
        "baseline": "QuickWrite owns menu selection and command mapping while rendering through SchemaMenuBar."
      },
      "QuickWriteStatusBar": {
        "classification": "adapter",
        "paths": [
          "src/apps/quick-write/QuickWriteStatusBar.tsx"
        ],
        "baseline": "QuickWrite adapts its document status model to the retained shared StatusBarView."
      },
      "SchemaMenuBar": {
        "classification": "writer-retain",
        "paths": [
          "src/ui/chrome/SchemaMenuBar.tsx",
          "src/ui/chrome/menuSchema.ts"
        ],
        "baseline": "Shared Writer chrome rendering is retained as product UI, not promoted to pure core."
      },
      "StatusBarView": {
        "classification": "writer-retain",
        "paths": [
          "src/ui/statusbar/StatusBarView.tsx",
          "src/ui/statusbar/statusBarUtils.ts"
        ],
        "baseline": "Shared Writer status presentation is retained as product UI, with QuickWrite data supplied by an adapter."
      },
      "SettingsPanel": {
        "classification": "writer-retain",
        "paths": [
          "src/ui/components/Settings/SettingsPanel.tsx",
          "src/domains/settings/state/settingsStore.ts"
        ],
        "baseline": "Shared Writer settings UI remains retained product UI; QuickWrite only constrains its usage."
      },
      "PlatformTitleBar": {
        "classification": "writer-retain",
        "paths": [
          "src/ui/chrome/PlatformTitleBar.tsx"
        ],
        "baseline": "Shared Writer titlebar selection stays retained product UI behind the QuickWrite shell."
      },
      "TitleBar": {
        "classification": "writer-retain",
        "paths": [
          "src/ui/chrome/MacTitleBar.tsx",
          "src/ui/chrome/WindowsTitleBar.tsx"
        ],
        "baseline": "Concrete Writer titlebar views are retained product UI and must not be recast as pure core."
      },
      "SingleDocumentEditor": {
        "classification": "writer-retain",
        "paths": [
          "src/domains/editor/core/SingleDocumentEditor.tsx"
        ],
        "baseline": "The existing shared single-document editor surface is retained; QuickWrite must not rewrite it as a local textarea or direct Tiptap editor."
      }
    }
  },
  "productionImportRoots": [
    "src/apps/quick-write"
  ],
  "allowedProductionDependencies": {
    "corePublicExports": [
      "src/core/autosave",
      "src/core/command",
      "src/core/editor",
      "src/core/runtime",
      "src/core/session"
    ],
    "sharedEditorAdapters": [
      "src/domains/editor/core/SingleDocumentEditor"
    ],
    "sharedSettingsAndStatus": [
      "src/domains/settings/state/settingsStore",
      "src/state/slices/statusSlice",
      "src/ui/statusbar/StatusBarView",
      "src/ui/statusbar/statusBarUtils"
    ],
    "sharedChromeAdapters": [
      "src/ui/chrome",
      "src/ui/chrome/chromeState",
      "src/ui/chrome/SchemaMenuBar",
      "src/ui/chrome/menuSchema"
    ],
    "sharedServiceAndRuntimeAdapters": [
      "src/config/editor",
      "src/services/runtime/TauriRuntimePorts",
      "src/ui/components/Settings"
    ],
    "externalRuntime": [
      "@tauri-apps/api/event",
      "@tauri-apps/api/window",
      "react",
      "react-dom/client"
    ]
  },
  "forbiddenProductionDependencies": {
    "writerWorkspaceAndFileTree": [
      "src/domains/workspace",
      "src/domains/file",
      "src/ui/workspace",
      "src/ui/sidebar",
      "src/ui/components/VirtualizedFileTree",
      "src/ui/components/RecentWorkspaces",
      "src/shared/components/ContextMenu/fileTreeMenu",
      "src/shared/components/ContextMenu/workspaceRootMenu"
    ],
    "writerRecentWorkspaceSurface": [
      "RecentItemsService",
      "RecentWorkspacesMenu",
      "useWorkspaceStore",
      "WorkspaceManager",
      "workspaceActions",
      "useFileTreeStore"
    ],
    "writerAppShellDeepPaths": [
      "src/app",
      "src/app/App",
      "src/app/AppChrome",
      "src/app/commands",
      "src/ui/statusbar/StatusBar"
    ],
    "editorImplementationDeepPaths": [
      "src/domains/editor/core/EditorImpl",
      "src/domains/editor/core/EditorStateFacade",
      "src/domains/editor/core/useEditorInstanceController",
      "src/domains/editor/hooks/imageActions"
    ],
    "rejectedQuickWriteCopies": [
      "src/apps/quick-write/QuickWriteRichEditor.tsx",
      "src/apps/quick-write/quickWriteMenu.ts",
      "src/apps/quick-write/QuickWriteMenuBar.tsx"
    ]
  },
  "uiFidelityNotes": [
    "QuickWrite keeps its own app shell and CSS under src/apps/quick-write.",
    "QuickWrite may adapt shared Writer chrome, status, command bus, settings, runtime ports, and SingleDocumentEditor, but must not copy the Writer product UI or push Writer workspace UI into core.",
    "QuickWrite must not depend on Writer workspace, file tree, recent workspace, sidebar, or App.tsx shell paths.",
    "This manifest is an engineering gate for extraction readiness; it is not a physical move plan."
  ]
}
