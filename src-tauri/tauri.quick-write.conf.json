{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Writer QuickWrite",
  "identifier": "com.writer.quickwrite",
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "quick-write.html",
        "title": "Writer QuickWrite",
        "width": 860,
        "height": 620,
        "minWidth": 420,
        "minHeight": 360,
        "decorations": false,
        "resizable": true,
        "visible": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": null
  }
}
